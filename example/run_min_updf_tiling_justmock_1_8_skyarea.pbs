# mkdir -p "stdout/" 

cd "$PBS_O_WORKDIR" || exit 1
echo "$(pwd)"


source /home/zjding/installed_packages/miniforge3/etc/profile.d/conda.sh
conda activate just_tile_env

n_jobs=8
n_pix_jobs=8

echo "PBS_NP=${PBS_NP}"
echo "n_jobs: ${n_jobs}"
echo "n_pix_jobs: ${n_pix_jobs}"

time python min_updf_tiling_justmock_1_8_skyarea.py \
    --n_jobs ${n_jobs} \
    --n_pix_jobs ${n_pix_jobs} \
    --Npasses 3 \
    --odir ./output/
